# 9. Compare evidence across analytical stages
# This evaluates internal statistical consistency only.
#
# It is not a ranking of clinical importance.
# ============================================================
cross_method_evidence <- data.frame(
Variable =
baseline_variables,
Group_Test_BH =
baseline_variables %in%
bh_supported_variables$
Variable,
Univariable_Regression =
baseline_variables %in%
supported_univariable$
Variable,
Multivariable_Regression =
baseline_variables %in%
supported_multivariable$
Variable,
stringsAsFactors = FALSE
)
cross_method_evidence$Supported_Methods <-
rowSums(
cross_method_evidence[
c(
"Group_Test_BH",
"Univariable_Regression",
"Multivariable_Regression"
)
]
)
cross_method_evidence$Consistency <- ifelse(
cross_method_evidence$
Supported_Methods == 3,
"Supported across all three stages",
ifelse(
cross_method_evidence$
Supported_Methods == 2,
"Supported across two stages",
ifelse(
cross_method_evidence$
Supported_Methods == 1,
"Supported in one stage",
"No statistical support in these stages"
)
)
)
# ============================================================
# 10. Summarize exploratory correlation structure
# The ranking itself was created in script 07.
# ============================================================
strongest_correlations <- head(
correlation_analysis$
Ranked_Results,
3
)
strongest_correlations_display <-
strongest_correlations
if (nrow(strongest_correlations_display) > 0) {
strongest_correlations_display$
Spearman_Rho <- round(
strongest_correlations$
Spearman_Rho,
3
)
strongest_correlations_display$
Absolute_Correlation <- round(
strongest_correlations$
Absolute_Correlation,
3
)
strongest_correlations_display$
P_Value <- format.pval(
strongest_correlations$
P_Value,
digits = 4,
eps = 0.0001
)
}
# ============================================================
# 11. Summarize regression model behavior
# ============================================================
final_model_fit <-
regression_analysis$
Model_Fit
final_model_fit_display <-
round_numeric_columns(
final_model_fit,
digits = 4
)
# ============================================================
# 12. Summarize representation-model behavior
# ============================================================
representation_model_summary <-
representation_sensitivity_analysis$
Model_Comparison
representation_model_summary_display <-
round_numeric_columns(
representation_model_summary,
digits = 4
)
# ============================================================
# 13. Summarize sequential information addition
# ============================================================
representation_addition_summary <-
representation_sensitivity_analysis$
Sequential_Tests
representation_addition_summary_display <-
round_numeric_columns(
representation_addition_summary,
digits = 4
)
representation_addition_summary_display$
P_Value <- format.pval(
representation_addition_summary$
P_Value,
digits = 4,
eps = 0.0001
)
# ============================================================
# 14. Summarize coefficient stability
# ============================================================
coefficient_stability_summary <-
representation_sensitivity_analysis$
Coefficient_Stability
coefficient_stability_summary_display <-
round_numeric_columns(
coefficient_stability_summary,
digits = 4
)
# ============================================================
# 15. Summarize patient-level probability sensitivity
# ============================================================
probability_sensitivity_summary <-
representation_sensitivity_analysis$
Probability_Sensitivity
probability_sensitivity_display <-
round_numeric_columns(
probability_sensitivity_summary,
digits = 4
)
# ============================================================
# 16. Summarize illustrative representation reclassification
# ============================================================
representation_reclassification_summary <-
representation_sensitivity_analysis$
Reclassification
representation_reclassification_display <-
round_numeric_columns(
representation_reclassification_summary,
digits = 2
)
# ============================================================
# 17. Summarize dichotomization experiment
# ============================================================
dichotomization_model_summary <-
representation_sensitivity_analysis$
Dichotomization_Model_Comparison
dichotomization_probability_summary <-
representation_sensitivity_analysis$
Dichotomization_Probability_Sensitivity
dichotomization_reclassification_summary <-
representation_sensitivity_analysis$
Dichotomization_Reclassification
dichotomization_model_display <-
round_numeric_columns(
dichotomization_model_summary,
digits = 4
)
dichotomization_probability_display <-
round_numeric_columns(
dichotomization_probability_summary,
digits = 4
)
dichotomization_reclassification_display <-
round_numeric_columns(
dichotomization_reclassification_summary,
digits = 2
)
# ============================================================
# 18. Define evidence boundary
# These statements describe what the current project can and
# cannot support.
# ============================================================
supported_conclusions <- c(
"Describe the observed heart-failure patient sample",
"Describe mortality-group differences within the dataset",
"Identify statistically supported mortality-group differences",
"Estimate unadjusted mortality associations",
"Estimate mortality associations adjusted for available baseline variables",
"Describe exploratory correlation structure among continuous baseline variables",
"Evaluate sensitivity to different digital patient representations",
"Evaluate statistical information loss from simplifying a continuous variable"
)
unsupported_conclusions <- c(
"Establish causal effects",
"Recommend patient treatment",
"Define validated clinical thresholds",
"Provide externally validated individual mortality predictions",
"Determine optimal healthcare resource allocation",
"Evaluate actual healthcare-management interventions",
"Determine whether the available representation is clinically sufficient for every decision"
)
evidence_boundary <- list(
Supported =
supported_conclusions,
Not_Supported =
unsupported_conclusions
)
# ============================================================
# 19. Define potential healthcare decision contexts
# These are potential applications only.
# They are not evaluated or recommended by the project.
# ============================================================
decision_context <- data.frame(
Potential_Context = c(
"Population characterization",
"Risk-oriented service planning",
"Healthcare demand estimation",
"Capacity planning",
"Quality monitoring",
"Resource planning",
"Patient segmentation"
),
Current_Project_Status = rep(
"Potential relevance only; not directly evaluated",
7
),
stringsAsFactors = FALSE
)
# ============================================================
# 20. Define clinical and methodological boundary
# ============================================================
clinical_boundary <- data.frame(
Statistical_Analysis_Can_Evaluate = c(
"Observed distributions and group differences",
"Associations and statistical uncertainty",
"Model fit and internal consistency",
"Representation sensitivity",
"Information loss"
),
Requires_Additional_Clinical_or_Decision_Evidence = c(
"Clinical importance of observed differences",
"Causal interpretation",
"Treatment appropriateness",
"Clinical action thresholds",
"Real-world management validity"
),
stringsAsFactors = FALSE
)
# ============================================================
# 21. Define final interpretation principles
# ============================================================
final_principles <- c(
"Association does not establish causation.",
"Statistical significance does not establish clinical importance.",
"Adjusted associations remain conditional on available variables.",
"Digital patient data represent selected patient information, not the complete patient.",
"Changing the available patient representation can change statistical model output.",
"Simplifying continuous patient information may create measurable information loss.",
"In-sample model behavior is not external validation.",
"Statistical reliability and clinical validity are not equivalent."
)
# ============================================================
# 22. Create final project synthesis
# ============================================================
final_synthesis <- c(
paste0(
"The analyzed dataset contains ",
mortality_overview$Patients,
" patients, including ",
mortality_overview$Death_Events,
" recorded death events (",
round(
mortality_overview$
Mortality_Percentage,
1
),
"%)."
),
paste0(
"Benjamini-Hochberg-adjusted mortality-group evidence was ",
"observed for: ",
collapse_or_none(
bh_supported_variables$
Variable
),
"."
),
paste0(
"Nominally supported adjusted logistic-regression ",
"associations were observed for: ",
collapse_or_none(
supported_multivariable$
Variable
),
"."
),
paste0(
"The project-defined representation framework contains ",
representation_overview$
Defined_Dimensions,
" patient-information dimensions; ",
representation_overview$
Not_Represented,
" are classified as not represented in the available dataset."
),
paste0(
"The representation sensitivity analysis evaluates how ",
"model fit, coefficients, patient-level probabilities, and ",
"illustrative classifications change when the information ",
"available about the same patients is modified."
),
paste0(
"The dichotomization experiment evaluates whether reducing ",
"the granularity of ejection fraction changes model behavior ",
"and patient-level statistical output."
),
paste0(
"The project therefore evaluates statistical reliability ",
"within the available digital patient representation, but ",
"does not establish clinical validity or real-world ",
"healthcare-management decision validity."
)
)
# ============================================================
# 23. Consolidate final project results
# ============================================================
final_clinical_and_decision_insights <- list(
Mortality_Overview =
mortality_overview,
Representation_Overview =
representation_overview,
Descriptive_Outcome_Differences =
descriptive_outcome_differences,
Primary_Group_Tests =
primary_group_tests,
BH_Supported_Group_Findings =
bh_supported_variables,
Supported_Univariable_Associations =
supported_univariable,
Supported_Adjusted_Associations =
supported_multivariable,
Cross_Method_Evidence =
cross_method_evidence,
Strongest_Correlations =
strongest_correlations,
Regression_Model_Fit =
final_model_fit,
Representation_Model_Comparison =
representation_model_summary,
Sequential_Representation_Tests =
representation_addition_summary,
Coefficient_Stability =
coefficient_stability_summary,
Probability_Sensitivity =
probability_sensitivity_summary,
Representation_Reclassification =
representation_reclassification_summary,
Dichotomization_Model_Comparison =
dichotomization_model_summary,
Dichotomization_Probability_Sensitivity =
dichotomization_probability_summary,
Dichotomization_Reclassification =
dichotomization_reclassification_summary,
Evidence_Boundary =
evidence_boundary,
Decision_Context =
decision_context,
Clinical_Boundary =
clinical_boundary,
Interpretation_Principles =
final_principles,
Final_Synthesis =
final_synthesis
)
