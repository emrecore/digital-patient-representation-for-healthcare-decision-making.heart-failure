# ============================================================
# 25. Display final synthesis
# ============================================================
cat(
"\nFINAL SYNTHESIS\n\n"
)
for (statement in final_synthesis) {
cat(
"- ",
statement,
"\n",
sep = ""
)
}
cat(
"\nCORE PROJECT PRINCIPLE\n",
"A statistical model does not analyze the patient directly; ",
"it analyzes the available digital representation of the ",
"patient.\n\n",
"Statistical reliability therefore depends not only on the ",
"model itself, but also on what patient information was ",
"available, how it was represented, and what information ",
"was absent or simplified.\n",
sep = ""
)
